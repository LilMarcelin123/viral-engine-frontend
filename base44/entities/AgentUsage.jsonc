{
  "name": "AgentUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "date": {
      "type": "string",
      "description": "Fecha YYYY-MM-DD"
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de mensajes enviados al agente hoy"
    }
  },
  "required": [
    "user_id",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}