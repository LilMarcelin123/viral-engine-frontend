{
  "name": "CampaignVideo",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "enrollment_id": {
      "type": "string"
    },
    "editor_id": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string",
      "description": "URL del video en TikTok"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "pending=en cola, approved=v\u00e1lido, rejected=inv\u00e1lido (+1 strike)"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "rejection_reason": {
      "type": "string"
    },
    "last_scraped": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "campaign_id",
    "editor_id",
    "tiktok_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}